    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const projectNameInput = document.getElementById('projectName');
            // Select ALL checkboxes that have an ID (which covers all checklist items)
            const allCheckboxes = document.querySelectorAll('.form-check-input[id]:not([id^="pm_select_all"])'); // Exclude select-all if it existed
            const overallCompletionPercentageElement = document.getElementById('overallCompletionPercentage');
            const overallChartCtx = document.getElementById('overallCompletionPieChart').getContext('2d');

            let overallPieChart; // Declare chart variable globally

            const LOCAL_STORAGE_KEY_PREFIX = 'av_handover_checklist_';

            // --- Persistence (Local Storage) Functions ---
            function saveState() {
                const state = {};
                allCheckboxes.forEach(checkbox => {
                    state[checkbox.id] = checkbox.checked;
                });
                localStorage.setItem(LOCAL_STORAGE_KEY_PREFIX + 'checkboxState', JSON.stringify(state));
                localStorage.setItem(LOCAL_STORAGE_KEY_PREFIX + 'projectName', projectNameInput.value);
            }

            function loadState() {
                const savedCheckboxState = localStorage.getItem(LOCAL_STORAGE_KEY_PREFIX + 'checkboxState');
                if (savedCheckboxState) {
                    const state = JSON.parse(savedCheckboxState);
                    allCheckboxes.forEach(checkbox => {
                        if (state[checkbox.id] !== undefined) {
                            checkbox.checked = state[checkbox.id];
                        }
                    });
                }
                const savedProjectName = localStorage.getItem(LOCAL_STORAGE_KEY_PREFIX + 'projectName');
                if (savedProjectName) {
                    projectNameInput.value = savedProjectName;
                }
            }

            // --- Chart & Completion Functions ---
            function updateOverallCompletion() {
                let totalItems = allCheckboxes.length; // Now allCheckboxes ONLY contains the individual items
                let completedItems = 0;

                allCheckboxes.forEach(checkbox => {
                    if (checkbox.checked) {
                        completedItems++;
                    }
                });

                const percentage = totalItems === 0 ? 0 : Math.round((completedItems / totalItems) * 100);
                overallCompletionPercentageElement.textContent = percentage + '%';

                // Update Chart.js pie chart
                if (overallPieChart) {
                    overallPieChart.data.datasets[0].data = [percentage, 100 - percentage];
                    overallPieChart.data.datasets[0].backgroundColor = [
                        '#000080', // Dark blue for completed
                        '#e9ecef'   // Light gray for remaining
                    ];
                    overallPieChart.update();
                } else {
                    // Initialize chart if it doesn't exist
                    overallPieChart = new Chart(overallChartCtx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Completed', 'Remaining'],
                            datasets: [{
                                data: [percentage, 100 - percentage],
                                backgroundColor: [
                                    '#000080',
                                    '#e9ecef'
                                ],
                                borderColor: '#fff',
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: { display: false },
                                tooltip: { enabled: false }
                            },
                            animation: { 
                                animateRotate: true,
                                animateScale: true
                            }
                        }
                    });
                }
            }

            // --- Event Listeners ---
            projectNameInput.addEventListener('input', saveState);

            allCheckboxes.forEach(checkbox => {
                // Attach change listener to all individual checklist items
                checkbox.addEventListener('change', () => {
                    saveState();
                    updateOverallCompletion();
                });
            });

            // --- Initial Load ---
            loadState(); // Load saved state first
            updateOverallCompletion(); // Then update the chart and percentages based on loaded state
        });
    </script>
