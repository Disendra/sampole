<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AV Project Handover Checklist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa; /* Light gray background */
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .a4-page {
            width: 210mm; /* A4 width */
            min-height: 297mm; /* A4 height */
            margin: 20px auto; /* Center the page */
            background-color: #fff;
            border: 1px solid #dee2e6;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            padding: 25mm; /* Margins for A4 */
            box-sizing: border-box; /* Include padding in width/height */
        }
        h2.main-header {
            background-color: #000080; /* Dark blue */
            color: #fff;
            padding: 15px 20px;
            font-weight: bold;
            text-align: center;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 2.2rem;
        }
        h4.section-title {
            color: #000080;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: bold;
        }
        .accordion-button {
            background-color: #f0f2f5 !important;
            color: #000080 !important;
            font-weight: bold;
            border-bottom: 1px solid #dee2e6;
        }
        .accordion-button:focus {
            box-shadow: none;
        }
        .accordion-body {
            padding: 20px;
            border: 1px solid #dee2e6;
            border-top: none;
            background-color: #fff;
        }
        .checklist-item {
            margin-bottom: 8px;
            display: flex;
            align-items: flex-start;
        }
        .checklist-item .form-check-input {
            margin-top: 0.25rem;
            margin-right: 0.75rem;
        }
        .sub-checklist-group {
            margin-left: 25px; /* Indent sub-items */
            margin-top: 10px;
            border-left: 2px solid #e9ecef;
            padding-left: 10px;
        }
        .sub-checklist-group strong {
            display: block;
            margin-bottom: 5px;
            color: #495057;
        }
        .completion-summary {
            margin-top: 40px;
            padding: 20px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            background-color: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center; /* Center content horizontally */
            flex-wrap: wrap;
            gap: 20px; /* Space between chart and text */
        }
        .chart-container {
            width: 150px; /* Fixed size for the pie chart */
            height: 150px;
        }
        .percentage-info {
            text-align: center;
        }
        .percentage-text {
            font-size: 3rem;
            font-weight: bold;
            color: #000080;
            line-height: 1;
        }
        .percentage-label {
            font-size: 1.1rem;
            color: #6c757d;
            margin-top: 5px;
        }
        .project-info {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px dashed #dee2e6;
        }
        .project-info input {
            border: none;
            border-bottom: 1px solid #ced4da;
            border-radius: 0;
            padding: 5px 0;
            font-size: 1.1rem;
            font-weight: bold;
            width: 100%;
            text-align: center;
        }
        .project-info input:focus {
            outline: none;
            box-shadow: none;
            border-color: #000080;
        }
        /* Removed .accordion-item .form-check-input.select-all-checkbox styles as the element is removed */
        .download-button-container {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px dashed #dee2e6;
        }

        /* Print styles for a cleaner A4 printout */
        @media print {
            body {
                background-color: #fff;
                padding: 0;
            }
            .a4-page {
                border: none;
                box-shadow: none;
                margin: 0;
                width: auto;
                min-height: auto;
                padding: 0; /* Let print margins handle this */
            }
            .no-print {
                display: none !important;
            }
            .completion-summary, .project-info {
                border: 1px dashed #bbb !important; /* Make border lighter for print */
                background-color: #fff !important; /* White background for print */
            }
            /* Ensure accordion content is visible when printing */
            .accordion-collapse:not(.show) {
                display: block !important;
                visibility: visible !important;
            }
            .accordion-button::after {
                display: none !important; /* Hide accordion arrow */
            }
            .accordion-button {
                background-color: #fff !important;
                color: #000 !important;
                border: none !important;
                border-bottom: 1px dashed #bbb !important;
                padding-left: 0; /* No left padding for button in print */
            }
        }
    </style>
</head>
<body>

    <div class="a4-page">
        <h2 class="main-header">AV Project Handover Checklist</h2>

        <div class="project-info">
            <label for="projectName" class="form-label text-muted text-center d-block mb-2">Project Name</label>
            <input type="text" id="projectName" class="form-control" placeholder="Enter Project Name">
        </div>

        <div class="accordion" id="handoverChecklistAccordion">

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        I. Project Management & Administration
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_closeoutReport">
                            <label class="form-check-label" for="pm_closeoutReport">
                                Project Closeout Report/Summary
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_contactList">
                            <label class="form-check-label" for="pm_contactList">
                                Contact List (Integrator, Client, Vendors)
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_signoffDoc">
                            <label class="form-check-label" for="pm_signoffDoc">
                                Formal Sign-off/Acceptance Document
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_changeOrders">
                            <label class="form-check-label" for="pm_changeOrders">
                                Change Orders/Variations Log
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_punchList">
                            <label class="form-check-label" for="pm_punchList">
                                Punch List/Snag List (Completed & Verified)
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_paymentRecords">
                            <label class="form-check-label" for="pm_paymentRecords">
                                Payment Records
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_certificates">
                            <label class="form-check-label" for="pm_certificates">
                                Certificates of Completion (if applicable)
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pm_insurance">
                            <label class="form-check-label" for="pm_insurance">
                                Insurance Certificates/Waivers (if applicable)
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        II. Technical Documentation
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="sub-checklist-group">
                            <strong>As-Built Drawings:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_archFloorPlans">
                                <label class="form-check-label" for="td_archFloorPlans">Architectural Floor Plans</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_rcpPlans">
                                <label class="form-check-label" for="td_rcpPlans">Reflected Ceiling Plans (RCPs)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_systemSchematics">
                                <label class="form-check-label" for="td_systemSchematics">System Schematics/Line Diagrams</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_rackElevations">
                                <label class="form-check-label" for="td_rackElevations">Rack Elevations</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_wiringDiagrams">
                                <label class="form-check-label" for="td_wiringDiagrams">Wiring Diagrams/Cable Schedules</label>
                            </div>
                             <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_autocadPdf">
                                <label class="form-check-label" for="td_autocadPdf">All documents in AutoCAD & PDF files</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Equipment List/BOM:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_equipmentList">
                                <label class="form-check-label" for="td_equipmentList">Comprehensive Equipment List (with S/N, Firmware, Asset Tag, Location, Purchase Date)</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Control System Programming Files:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_controlProgram">
                                <label class="form-check-label" for="td_controlProgram">Latest Control System Program File</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_guiFiles">
                                <label class="form-check-label" for="td_guiFiles">Touch Panel GUI Files</label>
                            </div>
                             <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_customScripts">
                                <label class="form-check-label" for="td_customScripts">Any Custom Scripts, Macros, or Plugins Developed</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_programLogicDoc">
                                <label class="form-check-label" for="td_programLogicDoc">Detailed Documentation on Programming Logic & Functionality (including comments)</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Network Configuration Documentation:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_ipAddresses">
                                <label class="form-check-label" for="td_ipAddresses">Dedicated IP Addresses, Subnet Masks, Default Gateways</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_vlanPort">
                                <label class="form-check-label" for="td_vlanPort">VLAN IDs and Port Assignments on Network Switches</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_switchConfig">
                                <label class="form-check-label" for="td_switchConfig">Network Switch Configurations (PoE, Multicast, QoS)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_firewallRules">
                                <label class="form-check-label" for="td_firewallRules">Firewall Rules, Port Forwarding, Security Settings</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Audio System Calibration Reports:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_audioGainAEC">
                                <label class="form-check-label" for="td_audioGainAEC">Microphone Gain & Acoustic Echo Cancellation (AEC) Configurations</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_speakerEQ">
                                <label class="form-check-label" for="td_speakerEQ">Speaker Equalization (EQ) Curves & Delay Settings</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_mixerConfig">
                                <label class="form-check-label" for="td_mixerConfig">Mixer Configurations (Input/Output Levels, Routing)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_dspProgramBackup">
                                <label class="form-check-label" for="td_dspProgramBackup">DSP Program Backup File & Detailed Settings</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_audioCoverageSim">
                                <label class="form-check-label" for="td_audioCoverageSim">Audio Coverage Simulations (if performed, include final results)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_danteRoutingBackup">
                                <label class="form-check-label" for="td_danteRoutingBackup">Dante Routing File Backup (for key audio DSP)</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Video System Calibration Reports:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_displayCalibration">
                                <label class="form-check-label" for="td_displayCalibration">Display Calibration Settings (Brightness, Contrast, Color Temp, Gamma)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_scalerSettings">
                                <label class="form-check-label" for="td_scalerSettings">Scaler Settings and Aspect Ratio Configurations</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_videoWallConfig">
                                <label class="form-check-label" for="td_videoWallConfig">Video Wall Processor Configurations & Layout</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_videoCoverageSim">
                                <label class="form-check-label" for="td_videoCoverageSim">Video Coverage Simulations (if performed, include final results)</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Software Licenses and Keys:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_softwareLicenses">
                                <label class="form-check-label" for="td_softwareLicenses">Activation Keys, License Files, Subscription Details for all Software</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="td_licenseDetails">
                                <label class="form-check-label" for="td_licenseDetails">Clear Details on License Type, Expiration Dates, Renewal Processes/Contacts</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        III. Power and Cooling Requirements
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pcr_upsPower">
                            <label class="form-check-label" for="pcr_upsPower">
                                Total UPS Power Required (Calculated aggregate power consumption in Watts and VA)
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="pcr_coolingReq">
                            <label class="form-check-label" for="pcr_coolingReq">
                                Cooling Requirements (Calculated total heat load in BTU/hr or Watts & recommended capacity)
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        IV. Operational & Maintenance (O&M) Documentation
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="sub-checklist-group">
                            <strong>Operations Manuals/User Guides:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_userGuidesEndUser">
                                <label class="form-check-label" for="om_userGuidesEndUser">Simplified, task-oriented guides for end-users on common scenarios</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_dailyProcedures">
                                <label class="form-check-label" for="om_dailyProcedures">Clear instructions for daily system power on/off procedures</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_basicTroubleshooting">
                                <label class="form-check-label" for="om_basicTroubleshooting">Basic troubleshooting steps for common issues</label>
                            </div>
                             <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_visualGuides">
                                <label class="form-check-label" for="om_visualGuides">Visual guides (screenshots, labeled diagrams of touch panels)</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Maintenance Manuals:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_preventiveMaintenance">
                                <label class="form-check-label" for="om_preventiveMaintenance">Detailed instructions for routine preventive maintenance</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_maintenanceSchedules">
                                <label class="form-check-label" for="om_maintenanceSchedules">Recommended preventive maintenance schedules</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_sparePartsList">
                                <label class="form-check-label" for="om_sparePartsList">Recommended spare parts list with part numbers and suppliers</label>
                            </div>
                        </div>

                        <div class="sub-checklist-group mt-3">
                            <strong>Warranty Information:</strong>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_manufacturerWarranties">
                                <label class="form-check-label" for="om_manufacturerWarranties">Individual manufacturer warranties (scanned copies or links)</label>
                            </div>
                            <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_systemWarranty">
                                <label class="form-check-label" for="om_systemWarranty">Overall system warranty from the AV integrator (duration & terms)</label>
                            </div>
                             <div class="checklist-item form-check">
                                <input class="form-check-input" type="checkbox" value="" id="om_warrantyClaimsContact">
                                <label class="form-check-label" for="om_warrantyClaimsContact">Contact information and procedure for warranty claims</label>
                            </div>
                        </div>

                        <div class="checklist-item form-check mt-3">
                            <input class="form-check-input" type="checkbox" value="" id="om_manufacturerManuals">
                            <label class="form-check-label" for="om_manufacturerManuals">
                                Manufacturer Manuals/Datasheets (Original product manuals)
                            </label>
                        </div>
                         <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="om_dosDonts">
                            <label class="form-check-label" for="om_dosDonts">
                                Do's and Don'ts for AV System Operation & Maintenance
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingFive">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                        V. Service Level Agreements (SLAs)
                    </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="sla_responseTimes">
                            <label class="form-check-label" for="sla_responseTimes">
                                Response Times and Resolution Times
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="sla_coveredServices">
                            <label class="form-check-label" for="sla_coveredServices">
                                Covered Services and Excluded Services
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="sla_contactChannels">
                            <label class="form-check-label" for="sla_contactChannels">
                                Contact Channels for Support
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingSix">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                        VI. Training Materials
                    </button>
                </h2>
                <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#handoverChecklistAccordion">
                    <div class="accordion-body">
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tm_slidesHandouts">
                            <label class="form-check-label" for="tm_slidesHandouts">
                                Slides, Outlines, and Handouts used during user training sessions
                            </label>
                        </div>
                        <div class="checklist-item form-check">
                            <input class="form-check-input" type="checkbox" value="" id="tm_recordedVideos">
                            <label class="form-check-label" for="tm_recordedVideos">
                                Links to Recorded Training Videos
                            </label>
                        </div>
                        <div class="checklist-item form-check">
